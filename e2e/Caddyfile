# e2e config for the motel product binary: both modules' scenario
# suites run against this one config. Plain HTTP inside the compose
# network. The admin API is exposed so the reload-survival scenario can
# POST this same file to /load mid-traffic.
#
# Listeners: 8080/8081 = liveswap (proxy + webhook), 8082/8083 = the Deno/Node examples,
#            8090/8091/8092 = demo observed / observed and cached / cached (e2e/bench/observe.sh),
#            9080/9090/9091 = penaltybox (plain / cached / tiered).
{
	# TCP admin is TEST-ONLY (the runner container drives /load and
	# reads /metrics over the network). Production ships the admin API
	# on a unix socket — see packaging/Caddyfile for why. validate and
	# reload refuse a config that runs apps with the admin API on TCP
	# (cmd/motel's gate: every app can reach it); the liveswap block's
	# `allow_tcp_admin` below says it is meant here.
	admin 0.0.0.0:2019
	auto_https off

	# Souin HTTP cache backed by Otter (in-memory) storage.
	cache {
		ttl 30s
		otter
	}

	servers {
		# The e2e runner lives on the compose network (private range), so
		# its X-Forwarded-For is trusted and {client_ip} resolves to it —
		# this exercises penaltybox's real client-key path.
		trusted_proxies static private_ranges
	}

	liveswap {
		root /var/lib/liveswap
		allow_insecure_http
		allow_tcp_admin
		artifact_allowlist e2e-artifacts:8080
		deploy_trust local {
			public_key /shared/deploy.pub
			audience e2e
			# e2e/mint-token.sh mints one token for the volume's whole
			# life (--ttl 87600h), over the 24h a box accepts by default.
			max_token_ttl 87600h
		}

		app demo {
			# The two words are for the app, not the shell or systemd:
			# the server ignores them and reports them on /argv, where
			# scenario 3 checks they arrived as written.
			command ./server $HOME $$
			# A secret the crash scenario's release prints: the failed
			# deploy's response must carry the line with it redacted.
			env_file /etc/motel/demo.env
			health_interval 250ms
			health_timeout 1s
			soak 1s
			deadline 10s
			drain 500ms
			grace 3s
			# Short watchdog grace so the health-restart scenario can
			# heal the replacement (and re-probe) within seconds.
			watchdog_grace 5s
			keep 2
			# A declaration, which motel validates and otherwise
			# ignores: every scenario here runs with one loaded.
			backup {
				sqlite demo.db
				files  uploads
			}
			# Resource caps: scenario 4 reads them back from inside the
			# sandbox and from the manager; 7b changes cpu_quota on a
			# reload and reads the running unit's new cap. Wide enough
			# that no scenario's demo release comes near them.
			memory_max 256MB
			tasks_max 256
			cpu_quota 150%
		}

		# The Deno example (examples/deno), with the flags from its own
		# motel.caddy; only the e2e timings are added here.
		app deno-example {
			import /etc/motel/deno-example.caddy
			health_interval 250ms
			health_timeout 1s
			soak 1s
			deadline 20s
			drain 500ms
			grace 3s
		}

		# The Node example (examples/node): one executable, no runtime
		# on the box. Same e2e timings.
		app node-example {
			import /etc/motel/node-example.caddy
			health_interval 250ms
			health_timeout 1s
			soak 1s
			deadline 20s
			drain 500ms
			grace 3s
		}
	}
}

# ── liveswap: zero-downtime deploys ────────────────────────────────

:8080 {
	reverse_proxy {
		dynamic liveswap demo
	}
}

:8082 {
	reverse_proxy {
		dynamic liveswap deno-example
	}
}

:8083 {
	reverse_proxy {
		dynamic liveswap node-example
	}
}

:8081 {
	liveswap_webhook
}

# The observer's cost (e2e/bench/observe.sh): the same app as :8080,
# observed, cached, and both, so that one run measures each against the
# bare site.
:8090 {
	route {
		liveswap_observe demo
		reverse_proxy {
			dynamic liveswap demo
		}
	}
}

:8091 {
	route {
		liveswap_observe demo
		cache
		reverse_proxy {
			dynamic liveswap demo
		}
	}
}

:8092 {
	route {
		cache
		reverse_proxy {
			dynamic liveswap demo
		}
	}
}

# ── penaltybox: rate-limit hint enforcement ────────────────────────

# Plain penalty box, no caching. Budgets tuned small so the scenario
# script boxes quickly and recovers within seconds.
:9080 {
	route {
		hint_penaltybox {
			min_level 2
			window 10s
			limit 6
			penalty_ttl 3s
		}
		reverse_proxy e2e-upstream:8081
	}
}

# Penalty box in front of the Souin cache: boxed clients are rejected
# before the cache, stored responses replay their hint header through
# the module (so cache hits count and stay stripped).
:9090 {
	route {
		hint_penaltybox {
			min_level 2
			window 10s
			limit 6
			penalty_ttl 3s
		}
		cache
		reverse_proxy e2e-upstream:8081
	}
}

# Two-tier policy: tight tier-3 budget, loose tier-2 budget, enforced
# independently per client.
:9091 {
	route {
		hint_penaltybox {
			tier 3 {
				window 30s
				limit 2
				penalty_ttl 3s
			}
			tier 2 {
				window 30s
				limit 50
				penalty_ttl 1m
			}
		}
		reverse_proxy e2e-upstream:8081
	}
}
