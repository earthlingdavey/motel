		person alice@example.com sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAIE8uRqz5M5bWRREzeUk+Dsafwa11Oq9W+nafo+K2hQJ9AAAABHNzaDo=
		person bob@example.com   ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBAEDlhi8zbEURRrj0bvYj+S5Pox9160W3LOyqH7nkMZVMdjJyW0+oemQB7XlU10E4Z6HZpXfHg2e4JJ7B6zgFDw=

		grant alice@example.com viewer box
		grant bob@example.com   viewer app example
		grant bob@example.com   viewer app blog from 198.51.100.0/24 2001:db8:5::/48
	}

	monitor {
		channel ops json https://hooks.example.com/motel
	}

	liveswap {
		app blog {
			command ./blog
		}
		app example {
			command ./example
		}
	}
}

deploy.example.com {
	liveswap_webhook
	box_webhook
}
