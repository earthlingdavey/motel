# The design's sample (DESIGN-box.md, "People and grants"), and an
# ssh-rsa signer, which is no person's key and prints no person line:
# describe prints the golden beside this file. The keys are public
# halves only.
{
	box {
		deploy_trust github {
			audience motel
			claim repository your-org/boxes
		}
		signer alice@example.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJTxbCB1QdiskXvEbkxkjl5p09A5ZsEN9HC/xOJOxi8j
		signer carol@example.com ssh-rsa 

		person alice@example.com sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAILX9o34V95jemufjvXcibmMm8mYtok4vd2ryhihSoTyTAAAABHNzaDo=
		person bob@example.com   ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILoDBHCP9BTSBnqM2NjTOEJlf2VVKycJulDE9ZXRYmiG

		grant alice@example.com viewer box
		grant bob@example.com   viewer app example
		grant bob@example.com   viewer app blog from 198.51.100.0/24 2001:db8:5::/48
		grant bob@example.com   logs app example from 198.51.100.0/24
	}

	monitor {
		channel ops json https://hooks.example.com/motel
	}

	liveswap {
		app blog {
			command ./blog
		}
		app example {
			command ./example
		}
	}
}

deploy.example.com {
	liveswap_webhook
	box_webhook
}
