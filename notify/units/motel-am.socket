# Written by `motel monitor setup` (notify/DESIGN-notify.md, "Packaging and
# setup"). Alertmanager's listener in the host's namespace: a unix
# socket in a runtime directory of its own (not /run/motel, which
# motel.service removes whenever motel stops), 0660 root:motel. Every
# app runs as the motel uid, so the group is not what keeps apps out: no
# app's sandbox has /run/motel-notify in its view. The group keeps out
# every other system user. No TCP port is opened in the host's
# namespace, so nothing there listens on 9093 or the cluster's 9094;
# with the store (setup --metrics), Alertmanager's one other listener is
# motel-am-metrics.socket's, inside the metrics namespace.
[Unit]
Description=Alertmanager's unix socket, for root and motel (motel monitor setup)

[Socket]
# The service is not named after the socket.
Service=prometheus-alertmanager.service
ListenStream=/run/motel-notify/am.sock
SocketUser=root
SocketGroup=motel
SocketMode=0660
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
