# Written by `motel metrics setup` (notify/DESIGN-metrics.md, "The shape").
# Started by motel-am-proxy.socket: forwards vmalert's posts, and the
# store's scrape of Alertmanager's /metrics, to Alertmanager's socket.
[Unit]
Description=Bridge the metrics namespace's 127.0.0.1:9093 to Alertmanager's unix socket
Requires=motel-am-proxy.socket motel-am.socket
After=motel-am-proxy.socket motel-am.socket

[Service]
Type=notify
NetworkNamespacePath=/run/netns/motel-metrics
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=5min /run/motel-notify/am.sock
# Not root, and no capability. Its one reach is Alertmanager's socket,
# 0660 root:motel, so it holds the group, and the group also reads what
# the motel uid reads (the env files, the box's exchange tree): so the
# view is deny-by-default, as an app's is (liveswap/sandbox.go), an empty
# root with the OS the proxy runs on, the socket's directory and
# systemd's notify socket bound back read-only. That needs a static uid:
# DynamicUser= implies ProtectSystem=strict, under which systemd does not
# mount the empty root (measured, systemd 257). The uid is the namespace
# daemons' own, the proxy's only clients, and motel is its primary group,
# not a supplementary one: the kernel lets a process attach to, or read
# the /proc of, one whose uid and gids all match its own, whatever their
# supplementary groups, so with the store's gid the store could act as
# the proxy, group and all, past this view (Debian leaves ptrace_scope at
# 0). With motel's gid it is refused (measured). PrivateUsers= would
# refuse it too; it failed (217/USER) beside a supplementary group, and
# with motel as the primary group it is untried.
User=_victoria-metrics
Group=motel
CapabilityBoundingSet=
TemporaryFileSystem=/:ro
BindReadOnlyPaths=/usr -/bin -/lib -/lib64 -/etc/ld.so.cache /run/motel-notify /run/systemd/notify
PrivateDevices=yes
PrivateTmp=yes
NoNewPrivileges=yes
