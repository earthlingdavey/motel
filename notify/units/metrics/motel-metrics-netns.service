# Written by `motel metrics setup` (notify/DESIGN-metrics.md, "The shape").
# A network namespace holding a loopback only, for the metrics store and
# vmalert, which speak TCP: what listens in here is reachable from no app,
# since every app shares the host's namespace.
[Unit]
Description=Private network namespace for the metrics store and vmalert (motel metrics setup)
Before=victoria-metrics.service motel-vmalert.service motel-am-proxy.socket motel-vm.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A namespace left by a start that failed half-way, or a stop that did
# not run, would make the add fail with "File exists" at every start.
ExecStartPre=-/usr/sbin/ip netns delete motel-metrics
ExecStart=/usr/sbin/ip netns add motel-metrics
ExecStart=/usr/sbin/ip -n motel-metrics link set lo up
ExecStop=/usr/sbin/ip netns delete motel-metrics

[Install]
WantedBy=multi-user.target
